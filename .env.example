# Public URL of the deployed site — used for canonical URLs, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery via Resend (https://resend.com).
# The form will NOT report success until all three are set and Resend accepts the message.
RESEND_API_KEY=
# Inbox that receives inquiries (comma-separate several addresses).
CONTACT_TO_EMAIL=
# A sender on a domain verified in Resend, e.g. "Code Velocity <inquiries@yourdomain.com>".
CONTACT_FROM_EMAIL=
